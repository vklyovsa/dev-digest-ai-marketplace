{
  "description": "Read-only guard for research-tools:researcher: blocks the write tools and file-writing Bash for that agent only.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/readonly-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
